        {
          "name": "13. DELETE con multiples coincidencias (409)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{base_url}}/sensores/presion",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "sensores",
                "presion"
              ]
            },
            "description": "Intenta eliminar 'el' sensor de presion, pero hay 2 al mismo tiempo (creados en 13a/13b). Debe responder 409 Conflict y NO eliminar ningun documento."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code es 409\", function () {",
