          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code es 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"El valor quedo actualizado\", function () {",
                  "    pm.expect(pm.response.json().valor).to.eql(40);",
                  "});"
                ]
