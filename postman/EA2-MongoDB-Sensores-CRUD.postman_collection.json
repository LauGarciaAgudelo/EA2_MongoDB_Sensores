            "description": "Lista todos los sensores existentes. Debe responder 200 OK con un arreglo JSON."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code es 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"La respuesta es un arreglo (lista) JSON\", function () {",
                  "    pm.expect(pm.response.json()).to.be.an(\"array\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "5. GET Filtrar por tipo (temperatura)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/sensores/?tipo=temperatura",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "sensores",
                ""
              ],
              "query": [
                {
                  "key": "tipo",
                  "value": "temperatura"
                }
              ]
            },
            "description": "Lista unicamente los sensores de tipo temperatura."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code es 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Todos los resultados son de tipo temperatura\", function () {",
                  "    const datos = pm.response.json();",
                  "    datos.forEach(function (sensor) {",
                  "        pm.expect(sensor.tipo).to.eql(\"temperatura\");",
                  "    });",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "6. PUT Actualizar sensor por tipo (temperatura)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/sensores/temperatura",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "sensores",
                "temperatura"
              ]
            },
            "description": "Actualiza el valor del unico sensor de tipo temperatura. Debe responder 200 OK.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"valor\": 40\n}",
              "options": {
                "raw": {
                  "language": "json"
