{
  "info": {
    "_postman_id": "4fff77fe-602b-4bf3-bb18-b10cb04ccd61",
    "name": "EA2 - MongoDB Sensores CRUD",
    "description": "Coleccion de pruebas funcionales para la API de sensores industriales (EA2 - Tecnologias Web). Cubre el CRUD completo, las operaciones por identificador, y los casos de error (validaciones, 404, 409).\n\nOrden recomendado: ejecutar las carpetas 01, 02 y 03 en orden (una por una, o con 'Run collection'), tomar las capturas de pantalla necesarias, y recien al final ejecutar la carpeta 04 - Limpieza para dejar la base de datos como estaba.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:5000",
      "type": "string"
    },
    {
      "key": "sensor_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "sensor_id_extra",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "01 - CRUD principal",
      "item": [
        {
          "name": "1. POST Crear sensor - Temperatura",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/sensores/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "sensores",
                ""
              ]
            },
            "description": "Crea un sensor de temperatura valido. Debe responder 201 Created.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tipo\": \"temperatura\",\n  \"valor\": 25.5,\n  \"ubicacion\": \"Planta A\",\n  \"fecha\": \"2026-11-13T10:30:00Z\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code es 201\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test(\"La respuesta tiene _id y tipo correcto\", function () {",
                  "    const datos = pm.response.json();",
                  "    pm.expect(datos).to.have.property(\"_id\");",
                  "    pm.expect(datos.tipo).to.eql(\"temperatura\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "2. POST Crear sensor - Presion",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/sensores/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "sensores",
                ""
              ]
            },
            "description": "Crea un sensor de presion valido. Debe responder 201 Created.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tipo\": \"presion\",\n  \"valor\": 120,\n  \"ubicacion\": \"Planta B\",\n  \"fecha\": \"2026-11-13T11:00:00Z\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code es 201\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test(\"El tipo creado es presion\", function () {",
                  "    pm.expect(pm.response.json().tipo).to.eql(\"presion\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "3. POST Crear sensor - Vibracion",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/sensores/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "sensores",
                ""
              ]
            },
            "description": "Crea un sensor de vibracion valido. Su _id se guarda en la variable de coleccion 'sensor_id' para usarlo luego en las operaciones por ID.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tipo\": \"vibracion\",\n  \"valor\": 2,\n  \"ubicacion\": \"Planta C\",\n  \"fecha\": \"2026-11-13T12:00:00Z\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code es 201\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "const datos = pm.response.json();",
                  "",
                  "// Solo guardamos el id si la variable esta vacia, para no",
                  "// sobrescribir accidentalmente un identificador ya capturado.",
                  "if (!pm.collectionVariables.get(\"sensor_id\")) {",
                  "    pm.collectionVariables.set(\"sensor_id\", datos._id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "4. GET Consultar todos los sensores",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/sensores/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "sensores",
