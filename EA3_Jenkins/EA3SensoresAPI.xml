<service>
  <id>EA3SensoresAPI</id>
  <name>EA3-Sensores-API</name>
  <description>API Flask de sensores industriales servida por Waitress.</description>

  <executable>%EA3_DEPLOY_ROOT%\app\.venv\Scripts\waitress-serve.exe</executable>
  <arguments>--listen=127.0.0.1:5000 API:app</arguments>
  <workingdirectory>%EA3_DEPLOY_ROOT%\app</workingdirectory>

  <serviceaccount>
    <domain>NT AUTHORITY</domain>
    <user>LocalService</user>
  </serviceaccount>

  <startmode>Automatic</startmode>
  <stoptimeout>30 sec</stoptimeout>
  <stopparentprocessfirst>true</stopparentprocessfirst>
  <onfailure action="restart" delay="10 sec" />
  <resetfailure>1 hour</resetfailure>

  <envFile>%ProgramData%\EA3-Sensores\service.env</envFile>

  <logpath>%ProgramData%\EA3-Sensores\logs</logpath>
  <log mode="roll" />
</service>
